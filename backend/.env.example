# Backend Configuration Example
PROJECT_NAME="Daily Living"
SECRET_KEY="your-super-secret-jwt-token-key-change-this"
DATABASE_URL="sqlite:///./meditation_guru.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/meditation_guru"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google AI Studio (Gemini API)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# AWS S3 & CloudFront Media Storage (Optional)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET_NAME="meditation-guru-media"
CLOUDFRONT_DOMAIN=""
